{
  "name": "@deveye/types",
  "version": "0.16.1",
  "description": "Shared contracts (types + zod schemas) for DevEye apps",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./sdk": {
      "types": "./src/sdk/index.ts",
      "default": "./src/sdk/index.ts"
    },
    "./sdk/server": {
      "types": "./src/sdk/server.ts",
      "default": "./src/sdk/server.ts"
    },
    "./sdk/client": {
      "types": "./src/sdk/client.ts",
      "default": "./src/sdk/client.ts"
    },
    "./sdk/testing": {
      "types": "./src/sdk/testing.ts",
      "default": "./src/sdk/testing.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "npm run ci",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gerem66/DevEye-Types.git"
  },
  "devDependencies": {
    "@eslint/js": "^8.0.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-prettier": "^5.5.4",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.39.1"
  },
  "type": "module",
  "license": "MIT",
  "author": "Gérémy L."
}
