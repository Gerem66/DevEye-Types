{
    "exclude": [
        "node_modules",
        "dist"
    ],
    "include": [
        "src"
    ],
    "compilerOptions": {
        "composite": true,
        "target": "es2024",
        "module": "ESNext",
        "lib": [
            "es2024",
            "esnext.asynciterable"
        ],
        "sourceMap": false,
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": true,
        "declaration": true,
        "declarationMap": true,
        "removeComments": false,
        "pretty": true,
        "paths": {
            "deveye-types": [
                "./src/index.ts"
            ],
            "deveye-types/sdk": [
                "./src/sdk/index.ts"
            ]
        }
    }
}
